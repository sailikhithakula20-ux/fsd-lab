# Flask Application Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production

# Database Configuration (MySQL)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
# Example: mysql+pymysql://root:password@localhost:3306/health_portal_db
DATABASE_URL=sqlite:///health_portal.db
MYSQL_DATABASE_URL=mysql+pymysql://root:password@localhost:3306/health_portal_db

# Google Gemini API Configuration for RAG & GenAI Assistant
# Obtain free API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Application Preferences
APP_NAME="Preventive Health AI Portal"
SESSION_COOKIE_SECURE=False
REMEMBER_COOKIE_DURATION=2592000
