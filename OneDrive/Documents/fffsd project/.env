FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-health-portal-secret-key-2026-secure-random

# Database Configuration:
# By default, uses SQLite for seamless out-of-the-box local operation.
# To connect to your local MySQL server, change DATABASE_URL to:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/health_portal_db
DATABASE_URL=sqlite:///health_portal.db
MYSQL_DATABASE_URL=mysql+pymysql://root:password@localhost:3306/health_portal_db

# Google Gemini API Key (Optional in Phase 2; needed in Phase 10)
GEMINI_API_KEY=

APP_NAME="Preventive Health AI Portal"
SESSION_COOKIE_SECURE=False
